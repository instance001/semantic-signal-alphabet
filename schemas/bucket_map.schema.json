{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-signal-alphabet.org/schemas/bucket_map.schema.json",
  "title": "Semantic Signal Alphabet Bucket Map",
  "description": "Schema for a frozen semantic alphabet bucket map artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "model",
    "prompt_version",
    "bucket_count",
    "source_manifest",
    "created_at",
    "buckets",
    "unassigned_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the bucket map schema used by this artifact."
    },
    "artifact_type": {
      "const": "bucket_map"
    },
    "artifact_id": {
      "type": "string",
      "description": "Optional stable identifier for this specific generated artifact."
    },
    "model": {
      "type": "string",
      "description": "Name of the model used to generate the bucket map."
    },
    "prompt_version": {
      "type": "string",
      "description": "Version identifier for the generation prompt."
    },
    "bucket_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of active semantic buckets requested during generation."
    },
    "source_manifest": {
      "$ref": "#/$defs/sourceManifestRef"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Artifact creation timestamp in ISO 8601 format."
    },
    "notes": {
      "type": "string",
      "description": "Optional freeform notes about the generation run or intended use."
    },
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bucket"
      }
    },
    "unassigned_items": {
      "type": "array",
      "description": "Items intentionally left outside active buckets.",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sourceManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "source_kind"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "description": "High-level source type such as word_list, error_taxonomy, project_map, or domain_dataset."
        },
        "source_version": {
          "type": "string"
        },
        "source_uri": {
          "type": "string"
        }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_id",
        "label",
        "summary",
        "anchor_items",
        "assigned_items"
      ],
      "properties": {
        "bucket_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "anchor_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "assigned_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
