{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-signal-alphabet.org/schemas/source_manifest.schema.json",
  "title": "Semantic Signal Alphabet Source Manifest",
  "description": "Schema for describing a source dataset or source vocabulary used to generate a semantic alphabet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "source_id",
    "source_name",
    "source_kind",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "manifest_type": {
      "const": "source_manifest"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_kind": {
      "type": "string",
      "description": "High-level source type such as word_list, error_taxonomy, project_map, or domain_dataset."
    },
    "source_version": {
      "type": "string"
    },
    "source_uri": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
